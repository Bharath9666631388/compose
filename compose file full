---
version: "3"
services:
  bus-tickets:
    container_name: buscontainer
    build: ./bus-tickets
    ports:
      - "1111:80"
    volumes:
      - bus_volume:/usr/share/nginx/html
    networks:
      - bus
    environment:
      - SUBJECT=${COURSE_FEE}
      - BY=${MASTER_FOR}

  movie-tickets:
    container_name: moviecontainer
    build: ./movie-tickets
    ports:
      - "2222:80"
    volumes:
      - movie_volume:/usr/share/nginx/html
    networks:
      - movie
      - train

  train-tickets:
    container_name: traincontainer
    build: ./train-tickets
    ports:
      - "3333:80"
    volumes:
      - train_volume:/usr/share/nginx/html
    networks:
      - train

volumes:
  bus_volume:
  movie_volume:
  train_volume:

networks:
  bus:
    driver: bridge
  movie:
    driver: bridge
  train:
    driver: bridge
